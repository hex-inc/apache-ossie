# name: test_databricks_tpcds_metric_view_to_hex[hex_files]
  '''
  --- store_sales/customer.yml ---
  id: customer
  base_sql_table: tpcds.public.customer
  dimensions:
  - id: birth_country
    type: string
    expr_sql: c_birth_country
  
  --- store_sales/date_dim.yml ---
  id: date_dim
  base_sql_table: tpcds.public.date_dim
  dimensions:
  - id: sold_year
    name: Year
    type: string
    expr_sql: d_year
  - id: sold_date
    type: string
    expr_sql: d_date
  
  --- store_sales/item.yml ---
  id: item
  base_sql_table: tpcds.public.item
  dimensions:
  - id: item_category
    type: string
    expr_sql: i_category
  - id: item_brand
    type: string
    expr_sql: i_brand
  
  --- store_sales/store_sales.yml ---
  id: store_sales
  base_sql_table: tpcds.public.store_sales
  dimensions:
  - id: ticket_number
    type: string
    expr_sql: ss_ticket_number
  relations:
  - id: store_sales_to_date_dim
    target: date_dim
    type: many_to_one
    join_sql: ss_sold_date_sk = ${store_sales_to_date_dim}.d_date_sk
  - id: store_sales_to_item
    target: item
    type: many_to_one
    join_sql: ss_item_sk = ${store_sales_to_item}.i_item_sk
  - id: store_sales_to_customer
    target: customer
    type: many_to_one
    join_sql: ss_customer_sk = ${store_sales_to_customer}.c_customer_sk
  
  '''
